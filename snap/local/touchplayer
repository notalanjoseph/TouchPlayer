#!/bin/sh
# Snap launcher. The core24 base already ships Python 3.12, so snapcraft leaves python3 out of the snap.
# Inside the snap, /usr/bin/python3 is that base's Python, never the host's. PyQt6 is staged under $SNAP.
unset PYTHONHOME
export PYTHONPATH="$SNAP/usr/lib/python3/dist-packages"
exec /usr/bin/python3 "$SNAP/opt/touchplayer/EasyPlayer.py" "$@"
